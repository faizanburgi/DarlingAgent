{
  "name": "campus-event-agent-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic prototype support for the Campus Event Agent WorkBuddy Expert Team.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "demo": "npm run build && node dist/scripts/run-demo.js",
    "mcp": "npm run build && node dist/scripts/run-mcp.js"
  },
  "bin": {
    "campus-event-agent": "dist/scripts/run-mcp.js"
  },
  "files": [
    "dist/**/*",
    "skills/**/*",
    "README.md",
    "packages/workbuddy-team/**/*",
    ".env.example"
  ],
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "better-sqlite3": "^13.0.3",
    "zod": "4.6.5"
  }
}
